# === Скопируй в .env и заполни:  cp .env.example .env ===

# LLM (мозг) через OpenRouter — как в основной версии
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Voximplant Management API (панель -> настройки аккаунта)
VOX_ACCOUNT_ID=
VOX_API_KEY=
# id правила приложения, к которому привязан сценарий voxengine_scenario.js
VOX_RULE_ID=
# номер, с которого звоним (арендованный в Voximplant или подтверждённый Caller ID)
VOX_CALLER_ID=+7495XXXXXXX

# Публичный URL этого бэкенда — облако Voximplant должно до него дотянуться.
# Для локального демо: запусти ngrok (ngrok http 8000) и вставь https-URL сюда.
PUBLIC_BACKEND_URL=https://xxxx.ngrok.app
