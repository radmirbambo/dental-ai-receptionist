# === Скопируй в .env и заполни ===
#   cp .env.example .env && export $(grep -v '^#' .env | xargs)

# LLM через OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o

# LiveKit Cloud (https://cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://ВАШ-ПРОЕКТ.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# ID выходного SIP-транка (создаётся один раз, см. README, шаг 3)
SIP_OUTBOUND_TRUNK_ID=ST_...

# Голос/распознавание (русский)
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
ELEVEN_VOICE_ID=            # id русскоязычного голоса из вашей библиотеки ElevenLabs
