# Скопируй этот файл в .env и вставь свой ключ:
#   cp .env.example .env
# Ключ берётся на https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Как подхватить .env перед запуском (вариант без лишних библиотек):
#   export $(cat .env | xargs) && python cli.py
# Либо поставь python-dotenv и загрузи в коде.
